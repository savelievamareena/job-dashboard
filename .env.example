# Folder the skills write into: it must contain DailySearch/<date>/<track>/selected.csv, and
# cv-tailored/Poland/<core>/review-queue.csv for the CV column.
# Copy this file to .env and set your own path. .env is gitignored.
DASHBOARD_ROOT=/path/to/your/CVs

# Postgres from docker-compose.yml. Start it with: docker compose up -d
# The dashboard reads the vacancy files without it; only the statistics page needs it.
DB_URL=jdbc:postgresql://localhost:5432/jobdashboard
DB_USER=postgres
DB_PASSWORD=change-me
